<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.travelstats.mapper.RangeConfigMapper">

    <select id="findByQueryType" resultType="com.example.travelstats.entity.QueryRangeConfig">
        SELECT * FROM query_range_config
        WHERE query_type = #{queryType}
        ORDER BY id ASC
    </select>

</mapper>
